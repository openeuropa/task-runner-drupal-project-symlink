{
    "name": "openeuropa/task-runner-drupal-project-symlink",
    "description": "OpenEuropa TaskRunner command to symlink a Drupal project codebase within a development site, built locally via Composer.",
    "keywords": ["Robo", "automation", "task-runner", "drupal"],
    "license": "EUPL-1.2",
    "type": "library",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.1",
        "openeuropa/task-runner": "^2.0.0-alpha5"
    },
    "require-dev": {
        "openeuropa/code-review-library": "^1.0.0-alpha1",
        "phpunit/phpunit": "^9.4"
    },
    "repositories": [
        {
            "type": "git",
            "url": "https://github.com/openeuropa/code-review-library.git"
        }
    ],
    "autoload": {
        "psr-4": {
            "OpenEuropa\\DrupalProjectSymlink\\": "./src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OpenEuropa\\DrupalProjectSymlink\\Tests\\": "./tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "phpro/grumphp-shim": true
        }
    }
}
